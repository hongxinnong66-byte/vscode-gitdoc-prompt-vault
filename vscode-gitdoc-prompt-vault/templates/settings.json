{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.wordWrap": "on",
  "markdown.preview.breaks": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "gitdoc.enabled": true,
  "gitdoc.autoCommitDelay": 30000,
  "gitdoc.autoPush": "onCommit",
  "gitdoc.autoPull": "onPush",
  "gitdoc.pullOnOpen": true,
  "gitdoc.commitOnClose": true,
  "gitdoc.pushMode": "push",
  "gitdoc.commitValidationLevel": "none",
  "gitdoc.timeZone": "Asia/Shanghai",
  "gitdoc.commitMessageFormat": "yyyy-MM-dd HH:mm:ss"
}
